{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "check-types": "tsc --noEmit -p . && tsc --noEmit -p test",
    "test": "vitest run",
    "cf-typegen": "wrangler types worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply exo --local",
    "db:migrate:remote": "wrangler d1 migrations apply exo --remote"
  },
  "dependencies": {
    "@exo/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.0.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@exo/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "vitest": "~4.1.0",
    "wrangler": "^4.150.0"
  }
}
