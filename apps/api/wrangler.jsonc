{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "exo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exo",
      "database_id": "82cd7644-1a11-4dd6-9a13-93239b204f0a",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "exo-files" }],
  "triggers": { "crons": ["0 3 * * *"] },
  "observability": { "enabled": true },
  "upload_source_maps": true,
}
