{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": { "dependsOn": ["^build"], "inputs": ["$TURBO_DEFAULT$", ".env*"], "outputs": ["dist/**"] },
    "check-types": { "dependsOn": ["^check-types"] },
    "test": { "dependsOn": ["^check-types"] },
    "dev": { "cache": false, "persistent": true }
  }
}
